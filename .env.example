# Database Settings
DB_HOST=localhost
DB_NAME=fortunett_technologies
DB_USER=fortunett_user
DB_PASS=YOUR_SECURE_PASSWORD

# JWT — REST API for mobile apps (Kotlin admin + customer apps)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# Other Environment Variables
# APP_ENV=production
# APP_DEBUG=false

# Authenticated email (use your existing verified sender; never commit real secrets)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS=your-account@gmail.com
# MAIL_FROM_NAME="FortuNett Technologies"
# MAIL_REPLY_TO=support@fortunetttech.site
