# Environment and Secrets
.env
.env.local
.env.production

# IDE and Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
*.error

# Temporary Files
tmp/
temp/
*.tmp

# Upload Directories (if any)
# Tenant-uploaded files are per-install data. The .htaccess is NOT — it is what
# stops anything in here being executed, so it has to ship with the code.
uploads/*
!uploads/.gitkeep
!uploads/.htaccess
!uploads/hotspot/
uploads/hotspot/*
!uploads/hotspot/.gitkeep

# Database Backups
*.sql.backup
backups/

# Node modules (if using any)
node_modules/

# Vendor (if using Composer)
vendor/
